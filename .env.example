# Supabase (Project Settings > API en el dashboard de Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key   # solo se usa en el servidor (cron)

# Resend (para el envío de correos de recordatorio)
RESEND_API_KEY=tu-resend-api-key

# Secreto para proteger el endpoint de cron
CRON_SECRET=genera-un-string-aleatorio-largo

# Credenciales del panel de admin (login simple, ver sección
# "Panel de administración" del README para más contexto)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456789
ADMIN_SESSION_SECRET=genera-otro-string-aleatorio-largo
